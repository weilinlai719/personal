---
// src/components/footer.astro
---
<footer class="footer">
    <p class="footertext">
      © 2026
      <a href="https://github.com/weilinlai" target="_blank">weilinlai</a>.
      All Rights Reserved.

    &emsp;瀏覽人數: <span id="footer-visitor-count">載入中...</span>人
    </p>
    <div class="footertext">
        <span>網頁已運行：</span>
        &nbsp;<span id="runtime-years">0</span> 年 
        &nbsp;<span id="runtime-days">0</span> 天 
        &nbsp;<span id="runtime-hours">0</span> 小時 
        &nbsp;<span id="runtime-minutes">0</span> 分 
        &nbsp;<span id="runtime-seconds">0</span> 秒
    </div>
</footer>

<style>
    .footer { 
        text-align: center;
        width: 100%;
        padding: 2rem 0; 
        margin-top: auto;  
        border-top: 1px solid var(--shadow-color2);
    }
    .footertext { 
        color: var(--secondary-text-color); 
        font-size: 0.85rem; 
    }
    .footertext a { 
        color: var(--text-color); 
        text-decoration: none; 
        font-weight: 500; 
    }
    .footertext a:hover { 
        text-decoration: underline; 
    }
    #footer-text-count {
        font-weight: bold;
        color: var(--text-color);
        margin: 0 4px;
    }
</style>

<script>
    const API_BASE_URL = 'https://words7000.onrender.com';

    // 產生不需授權的 Canvas + 環境特徵瀏覽器指紋
    async function getBrowserFingerprint() {
        const baseData = navigator.userAgent + 
                         navigator.language + 
                         screen.width + 'x' + screen.height + 
                         screen.colorDepth + 
                         new Date().getTimezoneOffset();
        
        const canvas = document.createElement('canvas');
        const ctx = canvas.getContext('2d');
        if (ctx) {
            ctx.textBaseline = 'top';
            ctx.font = '14px Arial';
            ctx.fillText('WeilinLai' + baseData, 2, 2);
        }
        const canvasData = canvas.toDataURL();
        
        const msgBuffer = new TextEncoder().encode(baseData + canvasData);
        const hashBuffer = await crypto.subtle.digest('SHA-256', msgBuffer);
        const hashArray = Array.from(new Uint8Array(hashBuffer));
        return hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
    }

    async function recordAndFetchVisitorCount() {
        try {
            const fingerprint = await getBrowserFingerprint();
            
            const visitorData = {
                screenResolution: `${window.screen.width}x${window.screen.height}`,
                language: navigator.language || navigator.language,
                url: window.location.href,
                fingerprint: fingerprint
            };

            const res = await fetch(`${API_BASE_URL}/api/visit`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(visitorData)
            });

            if (!res.ok) return;

            const data = await res.json();
            if (data.success) {
                const countSpan = document.getElementById('footer-visitor-count');
                if (countSpan) {
                    countSpan.innerText = data.count;
                }
            }
        } catch (error) {
            console.error('無法記錄或獲取訪客人數:', error);
            const countSpan = document.getElementById('footer-visitor-count');
            if (countSpan) {
                countSpan.innerText = '-';
            }
        }
    }

    function updateRuntime() {
    const startTime = new Date('2026-01-01T00:00:00').getTime();
    const now = new Date().getTime();
    const difference = now - startTime;


    // 計算 天、時、分、秒
    const years = Math.floor(difference / (1000 * 60 * 60 * 24 * 365));
    const days = Math.floor((difference / (1000 * 60 * 60 * 24)) % 365);
    const hours = Math.floor((difference / (1000 * 60 * 60)) % 24);
    const minutes = Math.floor((difference / 1000 / 60) % 60);
    const seconds = Math.floor((difference / 1000) % 60);

    // 更新 DOM 內容
    const yearsEl = document.getElementById('runtime-years');
    const daysEl = document.getElementById('runtime-days');
    const hoursEl = document.getElementById('runtime-hours');
    const minutesEl = document.getElementById('runtime-minutes');
    const secondsEl = document.getElementById('runtime-seconds');

    if (yearsEl) yearsEl.innerText = years.toString();
    if (daysEl) daysEl.innerText = days.toString();
    if (hoursEl) hoursEl.innerText = hours.toString();
    if (minutesEl) minutesEl.innerText = minutes.toString();
    if (secondsEl) secondsEl.innerText = seconds.toString();
  }

  updateRuntime();
  setInterval(updateRuntime, 1000);

    window.addEventListener('DOMContentLoaded', recordAndFetchVisitorCount);
</script>