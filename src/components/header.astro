---
// src/components/header.astro
import { getLangFromUrl, useTranslations, getLocalizedPath, getLangSwitchHref } from '../i18n/utils';
const pathname = Astro.url.pathname;
const isAbout = pathname.includes('/about');
const ispost = pathname.includes('/post');
const isarticle = pathname.includes('/article');

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const otherLang = lang === 'zh' ? 'en' : 'zh';
---

<header class="navbar">
  <div class="nav-container">
    <div class="nav-logo">
      <a href={getLocalizedPath(lang, '/')} class="logo-text">Weilin Lai</a>
    </div>

    <nav class="nav-menu" id="navMenu">
      <div class="nav-links">
        <a href={getLocalizedPath(lang, '/post/')} class:list={['nav-item', 'nav-link', { active: ispost }]}>
          {t('nav.posts')}
        </a>
        <a href={getLocalizedPath(lang, '/article/')} class:list={['nav-item', 'nav-link', { active: isarticle }]}>
          {t('nav.article')}
        </a>

        <div class="nav-item dropdown">
          <button class="dropdown-trigger" id="projectsTrigger">
            {t('nav.projects')}
            <svg class="chevron-icon" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>

          <div class="dropdown-content">
            <a href="https://weilinlai719.github.io/luckydraw" class="dropdown-link" target="_blank" rel="noopener noreferrer">
              <span class="link-title">{t('nav.projects.lottery')}</span>
            </a>
            <a href="https://weilinlai719.github.io/earth-science-explore/" class="dropdown-link" target="_blank" rel="noopener noreferrer">
              <span class="link-title">{t('nav.projects.earthscience')}</span>
            </a>
            <a href={getLocalizedPath(lang, '/projects/cui/')} class="dropdown-link" rel="noopener noreferrer">
              <span class="link-title">{t('nav.projects.cui')}</span>
            </a>
          </div>
        </div>

        <a href={getLocalizedPath(lang, '/about/')} class:list={['nav-item', 'nav-link', { active: isAbout }]}>
          {t('nav.about')}
        </a>
      </div>
    </nav>

    <!-- 右側控制區：語言切換 + 漢堡按鈕 -->
    <div class="nav-actions">
      <a
        href={getLangSwitchHref(Astro.url, otherLang)}
        class="lang-switch"
        id="langSwitchLink"
        data-target-lang={otherLang}
      >
        <img 
          src={otherLang === 'en' ? '/icon/en.svg' : '/icon/zh.svg'} 
          alt="lang icon" 
          class="lang-icon-img" 
        />
        <span class="lang-text">{otherLang === 'en' ? 'EN' : '中文'}</span>
      </a>

      <button class="menu-toggle" id="menuToggle" aria-label="切換選單">
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </button>
    </div>
  </div>
</header>

<style>
  .navbar {
    background: var(--header-bg, rgba(255, 255, 255, 0.65));
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--shadow-color2, #e5e7eb);
    position: sticky;
    top: 0;
    z-index: 1000;
    padding: 0 20px;
    height: 4rem;
    display: flex;
    align-items: center;
    width: 100%;
    box-sizing: border-box;
  }

  .nav-container {
    max-width: 800px;
    width: 100%;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
  }

  .logo-text {
    text-decoration: none;
    color: var(--text-color, #171717);
    font-weight: 600;
    font-size: 1.1rem;
  }

  /* 給桌面版保留，讓中間選單跟右邊按鈕能推開 */
  .nav-menu {
   display: flex;
  align-items: center;
  }
  @media screen and (min-width: 769px) {
  .nav-menu {
    margin-left: auto;   /* 自動把選單與右側按鈕推到右邊 */
    margin-right: 16px;  /* 選單與語言按鈕之間的舒服間距 */
  }

  .dropdown {
    position: relative;
  }
  .dropdown-content {
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(-10px);
    width: 240px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .dropdown:hover .dropdown-content {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(4px);
  }
  .dropdown:hover .chevron-icon {
    transform: rotate(180deg);
  }
}

  .nav-links {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .nav-item {
    text-decoration: none;
    color: var(--secondary-text-color, #6f6f6f);
    padding: 8px 16px;
    border-radius: 6px;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    font-size: 0.95rem;
    background: transparent;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .nav-link {
    text-decoration: none;
    color: inherit;
  }

  .nav-item.active, .nav-link.active {
    color: var(--text-color, #121213);
    font-weight: 500;
  }

  .nav-item:hover {
    color: var(--text-color, #000000);
    background: var(--shadow-color2, rgba(0,0,0,0.05));
  }

  .dropdown-trigger {
    font-family: inherit;
    font-size: inherit;
    color: inherit;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 4px;
    width: 100%;
    height: 100%;
  }

  .chevron-icon {
    width: 14px;
    height: 14px;
    fill: currentColor;
    transition: transform 0.3s ease;
  }

  .dropdown-content {
    position: absolute;
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    box-shadow: 0 12px 30px rgba(0,0,0,0.08);
    padding: 8px;
    box-sizing: border-box;
    z-index: 99999;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s;
  }

  .dropdown-link {
    display: block;
    color: #6f6f6f;
    padding: 12px 16px;
    text-decoration: none;
    border-radius: 8px;
    transition: all 0.2s ease;
  }

  .link-title {
    font-size: 0.95rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .dropdown-link:hover {
    background-color: #f5f5f5;
    color: #171717;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    z-index: 2000;
  }

  .lang-switch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 34px;
    padding: 0 12px;
    box-sizing: border-box;
    border-radius: 999px;
    background-color: #f0f2f5;
    color: #4a5568;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1;
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.08), 0 1px 1px rgba(255, 255, 255, 0.8);
    border: 1px solid rgba(0, 0, 0, 0.04);
    transition: all 0.25s ease;
    user-select: none;
    white-space: nowrap;
  }

  .lang-switch:hover {
    background-color: #e4e7eb;
    color: #1a202c;
  }

  .lang-icon-img {
    width: 16px;
    height: 16px;
    object-fit: contain;
    display: block;
    flex-shrink: 0;
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 22px;
    height: 15px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    z-index: 2000;
  }

  .hamburger-bar {
    width: 100%;
    height: 2px;
    background-color: var(--text-color, #171717);
    border-radius: 2px;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .menu-toggle.is-active .hamburger-bar:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }
  .menu-toggle.is-active .hamburger-bar:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  .menu-toggle.is-active .hamburger-bar:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  @media screen and (min-width: 769px) {
    .dropdown {
      position: relative;
    }
    .dropdown-content {
      top: 100%;
      left: 50%;
      transform: translateX(-50%) translateY(-10px);
      width: 240px;
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .dropdown:hover .dropdown-content {
      opacity: 1;
      visibility: visible;
      transform: translateX(-50%) translateY(4px);
    }
    .dropdown:hover .chevron-icon {
      transform: rotate(180deg);
    }
  }

  @media screen and (max-width: 768px) {
    .menu-toggle {
      display: flex;
    }
    /* 取消桌面版的 flex 佈局 */
    .nav-menu {
      position: absolute;
      top: 4rem;
      left: 0;
      right: 0;
      background: var(--header-bg, rgba(255, 255, 255, 0.85));
      backdrop-filter: blur(15px);
      -webkit-backdrop-filter: blur(15px);
      border-bottom: 1px solid var(--shadow-color2, #e5e7eb);
      padding: 5px 20px 24px 20px;
      border-radius: 12px;
      display: none; /* 預設隱藏 */
      flex-direction: column;
      z-index: 1500;
      max-height: calc(100vh - 4rem);
      overflow-y: auto;
    }
    .nav-menu.is-active {
      display: flex !important;
    }
    .nav-links {
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
    }
    .nav-item {
      width: 100%;
      box-sizing: border-box;
      justify-content: space-between;
      padding: 14px 18px;
      font-size: 1.05rem;
    }
    .dropdown {
      display: flex;
      flex-direction: column;
      align-items: stretch;
    }
    .dropdown-content {
      position: static;
      width: 100%;
      opacity: 1;
      visibility: visible;
      box-shadow: none;
      border: none;
      padding: 4px 0 4px 14px;
      margin-top: 6px;
      border-left: 2px solid #e5e7eb;
      display: none;
      flex-direction: column;
      gap: 6px;
      transform: none;
    }
    .dropdown-content.is-active {
      display: flex !important;
    }
    .dropdown-link {
      background-color: var(--shadow-color2, rgba(0, 0, 0, 0.02));
      padding: 12px 16px;
    }
    .dropdown-trigger.is-active .chevron-icon {
      transform: rotate(180deg);
    }
    .lang-switch {
      margin: 0;
    }
  }
</style>

<script>
  function toggleMobileMenu(e: Event) {
    e.stopPropagation();
    const menuToggle = document.getElementById('menuToggle');
    const navMenu = document.getElementById('navMenu');
    menuToggle?.classList.toggle('is-active');
    navMenu?.classList.toggle('is-active');
  }

  function handleDropdownToggle(e: Event) {
    if (window.innerWidth > 768) return;
    e.preventDefault();
    e.stopPropagation();
    const currentTrigger = e.currentTarget as HTMLElement;
    const dropdownContainer = currentTrigger.closest('.dropdown');
    const currentContent = dropdownContainer?.querySelector('.dropdown-content') as HTMLElement | null;

    if (currentContent) {
      const isCurrentlyActive = currentContent.classList.contains('is-active');
      document.querySelectorAll('.dropdown-content').forEach((c) => {
        if (c !== currentContent) c.classList.remove('is-active');
      });
      document.querySelectorAll('.dropdown-trigger').forEach((t) => {
        if (t !== currentTrigger) t.classList.remove('is-active');
      });

      if (isCurrentlyActive) {
        currentContent.classList.remove('is-active');
        currentTrigger.classList.remove('is-active');
      } else {
        currentContent.classList.add('is-active');
        currentTrigger.classList.add('is-active');
      }
    }
  }

  function closeAllMenusSafely(e: MouseEvent) {
    const target = e.target as HTMLElement;
    if (!target.closest('.nav-container')) {
      document.getElementById('menuToggle')?.classList.remove('is-active');
      document.getElementById('navMenu')?.classList.remove('is-active');
      document.querySelectorAll('.dropdown-content').forEach((c) => c.classList.remove('is-active'));
      document.querySelectorAll('.dropdown-trigger').forEach((t) => t.classList.remove('is-active'));
    }
  }

  // 使用者手動點了語言切換鈕，記住這個選擇，
  // 之後 mainlayout.astro 裡的自動偵測腳本就不會再蓋過使用者自己選的語言。
  function handleLangSwitchClick() {
    const link = document.getElementById('langSwitchLink');
    link?.addEventListener('click', () => {
      const targetLang = link.getAttribute('data-target-lang');
      if (targetLang) {
        try {
          localStorage.setItem('lang-pref', targetLang);
        } catch {
          // localStorage 被封鎖也沒關係，語言切換連結本身還是能正常導頁
        }
      }
    });
  }

  function initNavigationSystem() {
    const menuToggle = document.getElementById('menuToggle');
    const dropdownTriggers = document.querySelectorAll('.dropdown-trigger');

    if (menuToggle) {
      menuToggle.removeEventListener('click', toggleMobileMenu);
      menuToggle.addEventListener('click', toggleMobileMenu);
    }

    dropdownTriggers.forEach((trigger) => {
      trigger.removeEventListener('click', handleDropdownToggle);
      trigger.addEventListener('click', handleDropdownToggle);
    });

    document.removeEventListener('click', closeAllMenusSafely);
    document.addEventListener('click', closeAllMenusSafely);

    handleLangSwitchClick();
  }

  window.addEventListener('resize', () => {
    if (window.innerWidth > 768) {
      document.getElementById('menuToggle')?.classList.remove('is-active');
      document.getElementById('navMenu')?.classList.remove('is-active');
      document.querySelectorAll('.dropdown-content').forEach((c) => c.classList.remove('is-active'));
      document.querySelectorAll('.dropdown-trigger').forEach((t) => t.classList.remove('is-active'));
    }
  });

  initNavigationSystem();
  document.addEventListener('astro:page-load', initNavigationSystem);
</script>