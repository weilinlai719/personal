---
// src/components/header.astro
import { getLangFromUrl, useTranslations, getLocalizedPath, getLangSwitchHref } from '../i18n/utils';
const pathname = Astro.url.pathname;
const isAbout = pathname.includes('/about');
const ispost = pathname.includes('/post');
const isarticle = pathname.includes('/article');

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const otherLang = lang === 'zh' ? 'en' : 'zh';
---

<header class="navbar">
  <div class="nav-container">
    <div class="nav-logo">
      <a href={getLocalizedPath(lang, '/')} class="logo-text">Weilin Lai</a>
    </div>

    <nav class="nav-menu" id="navMenu">
      <div class="nav-links">
        <a href={getLocalizedPath(lang, '/post/')} class:list={['nav-item', 'nav-link', { active: ispost }]}>
          {t('nav.posts')}
        </a>
        <a href={getLocalizedPath(lang, '/article/')} class:list={['nav-item', 'nav-link', { active: isarticle }]}>
          {t('nav.article')}
        </a>

        <div class="nav-item dropdown">
          <button class="dropdown-trigger" id="projectsTrigger">
            {t('nav.projects')}
            <svg class="chevron-icon" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>

          <div class="dropdown-content">
            <a href="https://weilinlai719.github.io/luckydraw" class="dropdown-link" target="_blank" rel="noopener noreferrer">
              <span class="link-title">{t('nav.projects.lottery')}</span>
            </a>
            <a href="https://weilinlai719.github.io/earth-science-explore/" class="dropdown-link" target="_blank" rel="noopener noreferrer">
              <span class="link-title">{t('nav.projects.earthscience')}</span>
            </a>
            <a href={getLocalizedPath(lang, '/projects/cui/')} class="dropdown-link" rel="noopener noreferrer">
              <span class="link-title">{t('nav.projects.cui')}</span>
            </a>
          </div>
        </div>

        <a href={getLocalizedPath(lang, '/about/')} class:list={['nav-item', 'nav-link', { active: isAbout }]}>
          {t('nav.about')}
        </a>
      </div>
    </nav>

    <!-- 右側控制區：語言切換 + 漢堡按鈕 -->
    <div class="nav-actions">
      <a
        href={getLangSwitchHref(Astro.url, otherLang)}
        class="lang-switch"
        id="langSwitchLink"
        data-target-lang={otherLang}
      >
        <span class:list={['lang-switch-inner', { 'is-swapped': lang === 'en' }]} id="langSwitchInner">
          <img 
            src={otherLang === 'en' ? '/icon/en.svg' : '/icon/zh.svg'} 
            alt="lang icon" 
            class="lang-icon-img" 
            draggable="false"
          />
          <span class="lang-text">{otherLang === 'en' ? 'EN' : '中文'}</span>
        </span>
      </a>

      <button class="menu-toggle" id="menuToggle" aria-label="切換選單">
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </button>
    </div>
  </div>
</header>

<style>
  .navbar {
    background: var(--header-bg, rgba(255, 255, 255, 0.65));
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--shadow-color2, #e5e7eb);
    position: sticky;
    top: 0;
    z-index: 1000;
    padding: 0 20px;
    height: 4rem;
    display: flex;
    align-items: center;
    width: 100%;
    box-sizing: border-box;
  }

  .nav-container {
    max-width: 800px;
    width: 100%;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
  }

  .logo-text {
    text-decoration: none;
    color: var(--text-color, #171717);
    font-weight: 600;
    font-size: 1.1rem;
  }

  /* 給桌面版保留，讓中間選單跟右邊按鈕能推開 */
  .nav-menu {
   display: flex;
  align-items: center;
  }
  @media screen and (min-width: 769px) {
  .nav-menu {
    margin-left: auto;   /* 自動把選單與右側按鈕推到右邊 */
    margin-right: 16px;  /* 選單與語言按鈕之間的舒服間距 */
  }

  .dropdown {
    position: relative;
  }
  .dropdown-content {
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(-10px);
    width: 240px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .dropdown:hover .dropdown-content {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(4px);
  }
  .dropdown:hover .chevron-icon {
    transform: rotate(180deg);
  }
}

  .nav-links {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .nav-item {
    text-decoration: none;
    color: var(--secondary-text-color, #6f6f6f);
    padding: 8px 16px;
    border-radius: 6px;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    font-size: 0.95rem;
    background: transparent;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .nav-link {
    text-decoration: none;
    color: inherit;
  }

  .nav-item.active, .nav-link.active {
    color: var(--text-color, #121213);
    font-weight: 500;
  }

  .nav-item:hover {
    color: var(--text-color, #000000);
    background: var(--shadow-color2, rgba(0,0,0,0.05));
  }

  .dropdown-trigger {
    font-family: inherit;
    font-size: inherit;
    color: inherit;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 4px;
    width: 100%;
    height: 100%;
  }

  .chevron-icon {
    width: 14px;
    height: 14px;
    fill: currentColor;
    transition: transform 0.3s ease;
  }

  .dropdown-content {
    position: absolute;
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    box-shadow: 0 12px 30px rgba(0,0,0,0.08);
    padding: 8px;
    box-sizing: border-box;
    z-index: 99999;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s;
  }

  .dropdown-link {
    display: block;
    color: #6f6f6f;
    padding: 12px 16px;
    text-decoration: none;
    border-radius: 8px;
    transition: all 0.2s ease;
  }

  .link-title {
    font-size: 0.95rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .dropdown-link:hover {
    background-color: #f5f5f5;
    color: #171717;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    z-index: 2000;
  }

  .lang-switch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 34px;
    padding: 0 12px;
    box-sizing: border-box;
    border-radius: 999px;
    background-color: #f0f2f5;
    color: #4a5568;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1;
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.08), 0 1px 1px rgba(255, 255, 255, 0.8);
    border: 1px solid rgba(0, 0, 0, 0.04);
    transition: all 0.25s ease;
    user-select: none;
    white-space: nowrap;
  }

  .lang-switch:hover {
    background-color: #e4e7eb;
    color: #1a202c;
  }

  .lang-switch-inner {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .lang-icon-img {
    width: 16px;
    height: 16px;
    object-fit: contain;
    display: block;
    flex-shrink: 0;
    order: 0;
    cursor: grab;
    touch-action: none;
    -webkit-user-drag: none;
    user-select: none;
  }

  /* 拖曳中的暫時外觀：淡成米白色的小圓底，放開後就消失，不影響平常樣子。
     用 box-shadow 而不是 padding/margin，因為 box-shadow 不佔版面空間、
     不會影響 flex 排版計算，也就不會干擾拖曳時的位置量測。 */
  .lang-icon-img.is-dragging {
    cursor: grabbing;
    border-radius: 50%;
    box-shadow: 0 0 0 4px #f7efe0, 0 2px 6px rgba(0, 0, 0, 0.15);
  }

  .lang-text {
    order: 1;
  }

  /* 點擊時 icon 與文字交換位置：order 改變的瞬間先由 JS 用 transform 做 FLIP 動畫 */
  .lang-switch-inner.is-swapped .lang-icon-img {
    order: 1;
  }

  .lang-switch-inner.is-swapped .lang-text {
    order: 0;
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 22px;
    height: 15px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    z-index: 2000;
  }

  .hamburger-bar {
    width: 100%;
    height: 2px;
    background-color: var(--text-color, #171717);
    border-radius: 2px;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .menu-toggle.is-active .hamburger-bar:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }
  .menu-toggle.is-active .hamburger-bar:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  .menu-toggle.is-active .hamburger-bar:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  @media screen and (min-width: 769px) {
    .dropdown {
      position: relative;
    }
    .dropdown-content {
      top: 100%;
      left: 50%;
      transform: translateX(-50%) translateY(-10px);
      width: 240px;
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .dropdown:hover .dropdown-content {
      opacity: 1;
      visibility: visible;
      transform: translateX(-50%) translateY(4px);
    }
    .dropdown:hover .chevron-icon {
      transform: rotate(180deg);
    }
  }

  @media screen and (max-width: 768px) {
    .menu-toggle {
      display: flex;
    }
    /* 取消桌面版的 flex 佈局 */
    .nav-menu {
      position: absolute;
      top: 4rem;
      left: 0;
      right: 0;
      background: var(--header-bg, rgba(255, 255, 255, 0.85));
      backdrop-filter: blur(15px);
      -webkit-backdrop-filter: blur(15px);
      border-bottom: 1px solid var(--shadow-color2, #e5e7eb);
      padding: 5px 20px 24px 20px;
      border-radius: 12px;
      display: none; /* 預設隱藏 */
      flex-direction: column;
      z-index: 1500;
      max-height: calc(100vh - 4rem);
      overflow-y: auto;
    }
    .nav-menu.is-active {
      display: flex !important;
    }
    .nav-links {
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
    }
    .nav-item {
      width: 100%;
      box-sizing: border-box;
      justify-content: space-between;
      padding: 14px 18px;
      font-size: 1.05rem;
    }
    .dropdown {
      display: flex;
      flex-direction: column;
      align-items: stretch;
    }
    .dropdown-content {
      position: static;
      width: 100%;
      opacity: 1;
      visibility: visible;
      box-shadow: none;
      border: none;
      padding: 4px 0 4px 14px;
      margin-top: 6px;
      border-left: 2px solid #e5e7eb;
      display: none;
      flex-direction: column;
      gap: 6px;
      transform: none;
    }
    .dropdown-content.is-active {
      display: flex !important;
    }
    .dropdown-link {
      background-color: var(--shadow-color2, rgba(0, 0, 0, 0.02));
      padding: 12px 16px;
    }
    .dropdown-trigger.is-active .chevron-icon {
      transform: rotate(180deg);
    }
    .lang-switch {
      margin: 0;
    }
  }
</style>

<script>
  function toggleMobileMenu(e: Event) {
    e.stopPropagation();
    const menuToggle = document.getElementById('menuToggle');
    const navMenu = document.getElementById('navMenu');
    menuToggle?.classList.toggle('is-active');
    navMenu?.classList.toggle('is-active');
  }

  function handleDropdownToggle(e: Event) {
    if (window.innerWidth > 768) return;
    e.preventDefault();
    e.stopPropagation();
    const currentTrigger = e.currentTarget as HTMLElement;
    const dropdownContainer = currentTrigger.closest('.dropdown');
    const currentContent = dropdownContainer?.querySelector('.dropdown-content') as HTMLElement | null;

    if (currentContent) {
      const isCurrentlyActive = currentContent.classList.contains('is-active');
      document.querySelectorAll('.dropdown-content').forEach((c) => {
        if (c !== currentContent) c.classList.remove('is-active');
      });
      document.querySelectorAll('.dropdown-trigger').forEach((t) => {
        if (t !== currentTrigger) t.classList.remove('is-active');
      });

      if (isCurrentlyActive) {
        currentContent.classList.remove('is-active');
        currentTrigger.classList.remove('is-active');
      } else {
        currentContent.classList.add('is-active');
        currentTrigger.classList.add('is-active');
      }
    }
  }

  function closeAllMenusSafely(e: MouseEvent) {
    const target = e.target as HTMLElement;
    if (!target.closest('.nav-container')) {
      document.getElementById('menuToggle')?.classList.remove('is-active');
      document.getElementById('navMenu')?.classList.remove('is-active');
      document.querySelectorAll('.dropdown-content').forEach((c) => c.classList.remove('is-active'));
      document.querySelectorAll('.dropdown-trigger').forEach((t) => t.classList.remove('is-active'));
    }
  }

  // 使用 FLIP 技巧，讓 icon 與文字在切換 order 的瞬間，
  // 用 transform 從舊位置「滑」到新位置，而不是直接跳過去。
  // onMidSwap：在量測完舊位置、換 order 之前執行——用來即時換掉 icon 圖片與文字內容，
  // 讓「換位置」跟「換內容」同時發生，而不用等 reload 才看得到正確語言。
  function animateLangSwitchSwap(inner: HTMLElement, onMidSwap?: () => void) {
    const icon = inner.querySelector('.lang-icon-img') as HTMLElement | null;
    const text = inner.querySelector('.lang-text') as HTMLElement | null;
    if (!icon || !text) {
      onMidSwap?.();
      inner.classList.toggle('is-swapped');
      return;
    }

    // First：記錄交換前的位置
    const iconFirst = icon.getBoundingClientRect();
    const textFirst = text.getBoundingClientRect();

    // 換內容：icon src + 文字（文字寬度可能因此改變，例如 EN <-> 中文）
    onMidSwap?.();

    // Last：交換 order，取得交換後的位置
    inner.classList.toggle('is-swapped');
    const iconLast = icon.getBoundingClientRect();
    const textLast = text.getBoundingClientRect();

    // Invert：用 transform 讓元素瞬間「假裝」還在原位
    const iconDeltaX = iconFirst.left - iconLast.left;
    const textDeltaX = textFirst.left - textLast.left;

    [icon, text].forEach((el) => {
      el.style.transition = 'none';
    });
    icon.style.transform = `translateX(${iconDeltaX}px)`;
    text.style.transform = `translateX(${textDeltaX}px)`;

    // 強制 reflow，確保上面的 transform 先被套用
    void inner.offsetWidth;

    // Play：換回 transition，並把 transform 歸零，讓它動畫滑回真正的位置
    requestAnimationFrame(() => {
      [icon, text].forEach((el) => {
        el.style.transition = 'transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1)';
        el.style.transform = '';
      });
    });
  }

  // 把 icon 圖片與文字換成「導頁過去之後那頁應該顯示的下一個切換目標」，
  // 這樣使用者不用等 reload，點下去/拖過去的當下畫面就已經是對的。
  function swapLangSwitchContent(link: HTMLAnchorElement, inner: HTMLElement) {
    const icon = inner.querySelector('.lang-icon-img') as HTMLImageElement | null;
    const text = inner.querySelector('.lang-text') as HTMLElement | null;
    const targetLang = link.getAttribute('data-target-lang'); // 現在要前往的語言
    if (!icon || !text || !targetLang) return;

    // 到了新頁面之後，「下一個切換目標」會變成現在正要離開的這個語言
    const nextDisplayLang = targetLang === 'en' ? 'zh' : 'en';
    icon.src = nextDisplayLang === 'en' ? '/icon/en.svg' : '/icon/zh.svg';
    text.textContent = nextDisplayLang === 'en' ? 'EN' : '中文';
    link.setAttribute('data-target-lang', nextDisplayLang);
  }

  // 拖曳流程如果已經自己完成一次切換，緊接著瀏覽器補上的那個 click 事件
  // 就不用再處理一次（不然會重複存 localStorage、重複動畫、重複導頁）
  let suppressLangClick = false;

  // 真正「確定要切換」時共用的收尾流程：存偏好、換內容 + 播放交換動畫、動畫結束後才導頁。
  // 點擊路徑跟拖曳路徑都會走到這裡，行為保證一致。
  function completeLangSwitch(link: HTMLAnchorElement, inner: HTMLElement) {
    const targetLang = link.getAttribute('data-target-lang'); // 存 localStorage 用，要在內容被換掉之前先讀
    if (targetLang) {
      try {
        localStorage.setItem('lang-pref', targetLang);
      } catch {
        // localStorage 被封鎖也沒關係，語言切換連結本身還是能正常導頁
      }
    }
    const href = link.getAttribute('href');
    animateLangSwitchSwap(inner, () => swapLangSwitchContent(link, inner));
    window.setTimeout(() => {
      if (href) window.location.href = href;
    }, 350);
  }

  // 使用者手動點了語言切換鈕，記住這個選擇，
  // 之後 mainlayout.astro 裡的自動偵測腳本就不會再蓋過使用者自己選的語言。
  function onLangSwitchClick(e: MouseEvent) {
    if (suppressLangClick) {
      // 這個 click 是拖曳放開之後瀏覽器順便補的，剛才拖曳流程已經處理過了
      e.preventDefault();
      suppressLangClick = false;
      return;
    }

    const link = e.currentTarget as HTMLAnchorElement;
    const inner = document.getElementById('langSwitchInner');
    if (inner) {
      // 先播放 icon / 文字交換動畫，動畫結束後再真正導頁
      e.preventDefault();
      completeLangSwitch(link, inner);
    }
  }

  function handleLangSwitchClick() {
    const link = document.getElementById('langSwitchLink') as HTMLAnchorElement | null;
    if (!link) return;
    // 先移除舊的監聽器，避免每次 astro:page-load 都重複綁定，
    // 導致動畫被觸發兩次而互相抵銷（視覺上像沒交換，但網址照樣跳轉）。
    link.removeEventListener('click', onLangSwitchClick);
    link.addEventListener('click', onLangSwitchClick);
  }

  /**
   * 手動拖曳 icon：
   * - 抓著 icon 拖曳時會淡成米白色圓底，即時跟著手指/滑鼠移動；
   * - 放開時如果已經拖過 icon 可移動範圍的一半，就當作「確定要切換」，
   *   走跟點擊一樣的 completeLangSwitch（存偏好 → 換內容 → 播放交換動畫 → 動畫播完才導頁）；
   * - 沒拖過一半就彈回原本位置，語言不變、也不會導頁。
   */
  function initLangDrag() {
    const link = document.getElementById('langSwitchLink') as HTMLAnchorElement | null;
    const inner = document.getElementById('langSwitchInner') as HTMLElement | null;
    const icon = inner?.querySelector('.lang-icon-img') as HTMLElement | null;
    if (!link || !inner || !icon) return;
    if (icon.dataset.dragBound === '1') return; // 避免每次 astro:page-load 重複綁定
    icon.dataset.dragBound = '1';

    let dragging = false;
    let startClientX = 0;
    let startLeft = 0; // icon 拖曳開始時，相對 inner 容器左緣的距離
    let maxTravel = 0; // icon 在 inner 容器內，真正有效的可移動距離（0 ~ maxTravel）

    function measure() {
      const innerRect = inner!.getBoundingClientRect();
      const iconRect = icon!.getBoundingClientRect();
      startLeft = iconRect.left - innerRect.left;
      maxTravel = Math.max(0, innerRect.width - iconRect.width);
      console.log('[langDrag] measure', {
        isSwapped: inner!.classList.contains('is-swapped'),
        innerLeft: innerRect.left,
        innerWidth: innerRect.width,
        iconLeft: iconRect.left,
        iconWidth: iconRect.width,
        startLeft,
        maxTravel,
      });
    }

    // 貼著邊界繼續拖時的橡皮筋阻力：超出範圍越多，視覺上移動得越少，
    // 讓兩個方向拖起來都「有感覺」，而不是貼邊之後完全死掉不動。
    function rubberBand(overflow: number, resistance = 28) {
      return (overflow * resistance) / (overflow + resistance);
    }

    icon.addEventListener('pointerdown', (e: PointerEvent) => {
      dragging = true;
      // 一定要先量測，此時 icon 還沒被套上 is-dragging 的 padding/margin，
      // 量到的才是乾淨、左右對稱的正常位置。
      measure();
      icon.setPointerCapture(e.pointerId);
      icon.classList.add('is-dragging');
      icon.style.transition = 'none';
      startClientX = e.clientX;
    });

    icon.addEventListener('pointermove', (e: PointerEvent) => {
      if (!dragging) return;
      const delta = e.clientX - startClientX;
      const rawPos = startLeft + delta; // 還沒套用橡皮筋前，理論上的絕對位置

      let visualPos: number;
      if (rawPos < 0) {
        visualPos = -rubberBand(-rawPos);
      } else if (rawPos > maxTravel) {
        visualPos = maxTravel + rubberBand(rawPos - maxTravel);
      } else {
        visualPos = rawPos;
      }

      icon.style.transform = `translateX(${visualPos - startLeft}px)`;
    });

    function endDrag(e: PointerEvent) {
      if (!dragging) return;
      dragging = false;
      icon!.classList.remove('is-dragging');
      icon!.releasePointerCapture(e.pointerId);

      const delta = e.clientX - startClientX;
      const rawPos = startLeft + delta;
      // 判斷是否切換一律用「真正有效範圍內」夾出來的位置，橡皮筋多拖出去的部分不算數
      const trueClamped = Math.max(0, Math.min(maxTravel, rawPos));

      const crossedToRightHalf = maxTravel > 0 && trueClamped > maxTravel / 2;
      const alreadySwapped = inner!.classList.contains('is-swapped');
      // icon 現在停在跟目前 order 不同的那一半，代表使用者真的把它拖過去了
      const shouldSwitch = crossedToRightHalf !== alreadySwapped;

      console.log('[langDrag] endDrag', {
        delta,
        rawPos,
        trueClamped,
        maxTravel,
        startLeft,
        crossedToRightHalf,
        alreadySwapped,
        shouldSwitch,
      });

      // 只要這次放開前真的有拖動過（不是單純點一下），
      // 接下來瀏覽器在同一個 <a> 上補發的 click 一律吃掉——
      // 不然「拖過半又反悔拖回去」放開後，還是會被那個補發的 click 當成一般點擊誤切語言。
      const wasDragged = Math.abs(delta) > 3;
      if (wasDragged) {
        suppressLangClick = true;
      }

      if (shouldSwitch) {
        completeLangSwitch(link!, inner!);
      } else {
        // 沒拖過半，或是拖過半又反悔拖回去了：讓 icon 彈回原本位置，語言不變、不導頁
        icon!.style.transition = 'transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1)';
        icon!.style.transform = '';
      }
    }

    icon.addEventListener('pointerup', endDrag);
    icon.addEventListener('pointercancel', endDrag);
  }

  function initNavigationSystem() {
    const menuToggle = document.getElementById('menuToggle');
    const dropdownTriggers = document.querySelectorAll('.dropdown-trigger');

    if (menuToggle) {
      menuToggle.removeEventListener('click', toggleMobileMenu);
      menuToggle.addEventListener('click', toggleMobileMenu);
    }

    dropdownTriggers.forEach((trigger) => {
      trigger.removeEventListener('click', handleDropdownToggle);
      trigger.addEventListener('click', handleDropdownToggle);
    });

    document.removeEventListener('click', closeAllMenusSafely);
    document.addEventListener('click', closeAllMenusSafely);

    handleLangSwitchClick();
    initLangDrag();
  }

  window.addEventListener('resize', () => {
    if (window.innerWidth > 768) {
      document.getElementById('menuToggle')?.classList.remove('is-active');
      document.getElementById('navMenu')?.classList.remove('is-active');
      document.querySelectorAll('.dropdown-content').forEach((c) => c.classList.remove('is-active'));
      document.querySelectorAll('.dropdown-trigger').forEach((t) => t.classList.remove('is-active'));
    }
  });

  initNavigationSystem();
  document.addEventListener('astro:page-load', initNavigationSystem);
</script>