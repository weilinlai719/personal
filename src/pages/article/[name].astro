---
// src/pages/article/[name].astro
import MainLayout from '../../layout/mainlayout.astro';
import '../../styles/style.css';
import { getEntry, render } from 'astro:content';

export const prerender = false;
const { name } = Astro.params;
if (!name) return Astro.redirect('/404');
const entry = await getEntry('article', name);
if (!entry) return Astro.redirect('/404');
const { Content } = await render(entry);
const { title, date, subject } = entry.data;
---

<MainLayout title={`Weilin Lai - ${title}`}>
  <div class="list-page-container">
    <a href="/article/" class="article-back-btn">← 返回列表</a>
    <article class="article-post-card">
      <header class="article-detail-header">
        <div class="article-detail-title-wrapper">
          <div class="article-detail-orange-bar"></div>
          <h1 class="article-detail-title">{title}</h1>
        </div>
        <div class="article-detail-meta-wrapper">
          {date && <span class="article-detail-meta-pill">📅 {date}</span>}
          {subject && <span class="article-detail-meta-pill">{subject}</span>}
        </div>
      </header>
      <div class="md-content">
        <Content />
      </div>
    </article>
  </div>
</MainLayout>

<style is:global>
  /* 這個頁面跟文章列表頁一樣，是自己專屬的一套視覺（灰色系 meta 標籤、
     細的 back-btn），跟 post 系列的樣式不同，所以維持自己專屬的 class，
     只把 .list-page-container（850px 容器）跟共用的那份對齊，其餘不共用。

     這裡的樣式一定要 is:global：<Content /> 渲染出來的 markdown 內容
     不是這個元件自己畫的 DOM，Astro scoped style 的隔離屬性套不到它身上。 */

  .article-back-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: #6f6f6f;
    font-weight: 500;
    margin-bottom: 24px;
    transition: color 0.2s;
  }
  .article-back-btn:hover {
    color: #171717;
  }

  .article-post-card {
    background: #ffffff;
    border-radius: 16px;
    border: 1px solid #f0ede9;
    padding: 32px;
    box-shadow: 0 4px 12px rgba(160, 140, 130, 0.03);
  }

  .article-detail-title-wrapper {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 16px;
  }

  .article-detail-orange-bar {
    width: 4px;
    height: 32px;
    background-color: #ff7a00;
    border-radius: 2px;
    flex-shrink: 0;
  }

  .article-detail-title {
    font-size: 1.8rem;
    color: #2c3e50;
    margin: 0;
    font-weight: 700;
    line-height: 1.4;
  }

  .article-detail-meta-wrapper {
    display: flex;
    gap: 12px;
    margin-bottom: 32px;
  }

  .article-detail-meta-pill {
    background: #f5f5f7;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 0.85rem;
    color: #64748b;
  }

  /* ---- markdown 內文樣式 ---- */
  .md-content {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    line-height: 1.6;
    color: #24292e;
    word-wrap: break-word;
  }

  .md-content p, .md-content blockquote, .md-content ul, .md-content ol, .md-content pre, .md-content table {
    margin-top: 0;
    margin-bottom: 16px;
  }

  .md-content h1, .md-content h2, .md-content h3, .md-content h4, .md-content h5, .md-content h6 {
    margin-top: 24px;
    margin-bottom: 16px;
    font-weight: 600;
    line-height: 1.25;
  }
  .md-content h1 { font-size: 2em; border-bottom: 1px solid #eaecef; padding-bottom: 0.3em; }
  .md-content h2 { font-size: 1.5em; border-bottom: 1px solid #eaecef; padding-bottom: 0.3em; }
  .md-content h3 { font-size: 1.25em; }
  .md-content h4 { font-size: 1em; }
  .md-content h5 { font-size: 0.875em; }
  .md-content h6 { font-size: 0.85em; color: #6a737d; }

  .md-content a { color: #0366d6; text-decoration: none; }
  .md-content a:hover { text-decoration: underline; }
  .md-content strong { font-weight: 600; }
  .md-content hr { height: 0.25em; padding: 0; margin: 24px 0; background-color: #e1e4e8; border: 0; }

  .md-content ul { list-style-type: disc; padding-left: 2em; }
  .md-content ol { list-style-type: decimal; padding-left: 2em; }
  .md-content ul ul { list-style-type: circle; }
  .md-content ol ol { list-style-type: lower-alpha; }
  .md-content li + li { margin-top: 0.25em; }

  .md-content blockquote { border-left: 0.25em solid #dfe2e5; padding: 0 1em; color: #6a737d; }
  .md-content blockquote > :first-child { margin-top: 0; }
  .md-content blockquote > :last-child { margin-bottom: 0; }

  .md-content table { display: block; width: 100%; overflow: auto; border-collapse: collapse; }
  .md-content table th { font-weight: 600; }
  .md-content table th, .md-content table td { border: 1px solid #dfe2e5; padding: 6px 13px; }
  .md-content table tr { background-color: #fff; border-top: 1px solid #c6cbd1; }
  .md-content table tr:nth-child(2n) { background-color: #f6f8fa; }

  .md-content img { max-width: 100%; box-sizing: content-box; background-color: #fff; }
  .md-content code, .md-content pre { font-family: SFMono-Regular, Consolas, "Liberation Mono", Menlo, monospace; font-size: 85%; }
  .md-content code { background-color: rgba(27,31,35,0.05); padding: 0.2em 0.4em; border-radius: 3px; }
  .md-content pre {
    background-color: #f6f8fa;
    padding: 16px;
    padding-top: 36px;
    overflow: auto;
    border-radius: 6px;
    position: relative;
  }
  .md-content pre code { background: transparent; padding: 0; font-size: 100%; white-space: pre; word-break: normal; border: 0; }

  .copy-btn {
    position: absolute;
    top: 8px;
    right: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background-color: rgba(27,31,35,0.05);
    color: #f6f8fa;
    border-radius: 6px;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.2s, background-color 0.2s, color 0.2s;
    border: none;
    outline: none;
  }
  .md-content pre:hover .copy-btn { opacity: 1; }
  .copy-btn:hover { background-color: #f3f4f6; color: #24292e; }
  .copy-btn.copied { color: #1a7f37; border-color: #1a7f37; }

  .code-lang {
    position: absolute;
    top: 8px;
    left: 12px;
    font-size: 12px;
    font-family: -apple-system, sans-serif;
    font-weight: 600;
    color: #f0f6fc;
    text-transform: lowercase;
    user-select: none;
  }
</style>

<script>
function getLanguage(pre: HTMLElement, code: HTMLElement | null): string {
  const dataLang = 
    code?.getAttribute('data-language') || 
    pre.getAttribute('data-language') ||
    code?.getAttribute('data-lang') || 
    pre.getAttribute('data-lang') ||
    code?.getAttribute('lang') || 
    pre.getAttribute('lang');
    
  if (dataLang) return dataLang;

  const parentClass = pre.parentElement?.className || '';
  const combinedClass = `${parentClass} ${pre.className} ${code?.className || ''}`;
  
  const match = combinedClass.match(/(?:lang|language|highlight-source)-([\w-]+)/i);
  if (match) return match[1];

  return '';
}

function initCodeBlocks() {
  const COPY_ICON = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>`;
  const CHECK_ICON = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>`;

  document.querySelectorAll('.md-content pre').forEach((pre) => {
    const preEl = pre as HTMLElement;
    if (preEl.querySelector('.copy-btn')) return; 

    const codeEl = preEl.querySelector('code');
    const language = getLanguage(preEl, codeEl);
    const codeText = codeEl?.textContent || preEl.textContent || '';

    if (language) {
      const langTag = document.createElement('span');
      langTag.className = 'code-lang';
      langTag.textContent = language;
      preEl.appendChild(langTag);
    }

    const button = document.createElement('button');
    button.className = 'copy-btn';
    button.ariaLabel = 'Copy code';
    button.innerHTML = COPY_ICON;

    button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(codeText);
      button.innerHTML = CHECK_ICON;
      button.classList.add('copied');

      setTimeout(() => {
        button.innerHTML = COPY_ICON;
        button.classList.remove('copied');
      }, 2000);
    });

    preEl.appendChild(button);
  });
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initCodeBlocks);
} else {
  initCodeBlocks();
}
</script>
