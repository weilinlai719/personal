---
// src/pages/en/about.astro （英文版，網址 /en/about）
import MainLayout from '../../layout/mainlayout.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('en');
---

<MainLayout title={t('about.pageTitle')}>
    <div class="about-page-wrapper">
        
        <div class="avatar-flip-card" id="avatar-flip-card">
            <div class="avatar-flip-inner">
                <img 
                  src="/images/avatar.jpg" 
                  alt="Weilin Lai" 
                  class="about-avatar avatar-front" 
                />
                <img 
                  src="/images/avatar1.jpg" 
                  alt="Weilin Lai (flipped)" 
                  class="about-avatar avatar-back" 
                />
            </div>
        </div>

        <div class="about-info-text">
            <h1 class="author-name">Weilin Lai</h1>
            <p class="author-subtitle">Student / developer</p>
            <p class="author-subtitle">-116GSAT-</p>

            <div class="about-languages" style="margin-top: 0rem;">
                <span class="author-subtitle">language：</span>
                <img src="/icon/ts.svg" class="social-icon1" alt="typescript" />
                <img src="/icon/c.svg" class="social-icon1" alt="c" />
            </div>
            
            <div class="author-bio">
                <p>Worked with: APIs, backend, web, .NET, open-source libraries, GUI (on hold); haven't touched yet but want to: AI, algorithms, cybersecurity, drones, racing (NTU Formula Racing Team), rockets (Taiwan Rocket Competition)</p>
                <p>Who knows what's coming next — just gotta keep pushing forward!</p>
            </div>
        </div>

        <div class="about-social-networks">
            <a href="mailto:boblai719@gmail.com" class="social-button-card" title="Gmail">
                <img src="/icon/gmail.svg" class="social-icon" alt="Gmail" />
                <span class="social-text">Gmail</span>
            </a>

            <button type="button" class="social-button-card discord-copy-btn" title="Discord ID" data-discord-id="12072880926215454869">
                <img src="/icon/discord.svg" class="social-icon" alt="Discord" />
                <span class="social-text discord-text">Discord</span>
            </button>

            <a href="https://www.instagram.com/wei_lin_lai/" target="_blank" rel="noopener noreferrer" class="social-button-card" title="Instagram">
                <img src="/icon/instagram.svg" class="social-icon" alt="Instagram" />
                <span class="social-text">Instagram</span>
            </a>
            
            <a href="https://github.com/weilinlai" target="_blank" rel="noopener noreferrer" class="social-button-card" title="GitHub">
                <img src="/icon/github.svg" class="social-icon" alt="GitHub" />
                <span class="social-text">GitHub</span>
            </a>
        </div>

    </div>
</MainLayout>

<style>
    /* 這頁沒有 import styles/style.css，是刻意的：
       原始碼所有顏色都是 var(--x, fallback) 的形式，且原本專案還沒有共用的 style.css，
       fallback 值就是實際會生效的顏色。如果之後真的要接共用 style.css，
       要注意 style.css 裡的 --text-color / --secondary-text-color 等變數
       數值要跟這裡的 fallback 一致，不然這頁顏色會跟著變。 */

    .about-page-wrapper {
        max-width: 680px;
        margin: 4rem auto;
        padding: 0 1.5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .avatar-flip-card {
        width: 110px;
        height: 110px;
        perspective: 1000px;
        cursor: pointer;
        user-select: none;
        margin-bottom: 2rem;
        transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .avatar-flip-card:hover {
        transform: scale(1.08);
    }

    .avatar-flip-inner {
        position: relative;
        width: 100%;
        height: 100%;
        text-align: center;
        transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        transform-style: preserve-3d;
        -webkit-transform-style: preserve-3d;
    }

    .avatar-flip-card.flipped .avatar-flip-inner {
        transform: rotateY(180deg);
    }

    .about-avatar {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
        display: block !important;
        opacity: 1 !important;
        visibility: visible !important;
        -webkit-backface-visibility: hidden !important;
        backface-visibility: hidden !important;
        box-shadow: 0 4px 12px var(--shadow-color2, rgba(0, 0, 0, 0.05));
        transition: box-shadow 0.4s ease;
    }

    .avatar-front {
        z-index: 2;
        transform: rotateY(0deg) translateZ(1px);
    }

    .avatar-back {
        transform: rotateY(180deg) translateZ(1px);
    }

    .avatar-flip-card:hover .about-avatar {
        box-shadow: 0 8px 20px var(--shadow-color1, rgba(0, 0, 0, 0.1));
    }

    .author-name {
        font-size: 1.8rem;
        font-weight: 600;
        color: var(--text-color, #171717);
        margin-bottom: 0.6rem;
        letter-spacing: 0.5px;
    }

    .author-subtitle {
        font-size: 0.95rem;
        color: var(--secondary-text-color, #6f6f6f);
    }

    .author-bio {
        margin-top: 2.5rem;
        font-size: 0.95rem;
        color: var(--text-color, #171717);
        line-height: 1.8;
        margin-bottom: 3rem;
    }
    .author-bio p {
        margin-bottom: 0.5rem;
    }

    .about-social-networks {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap; 
        gap: 1rem; 
        width: 100%;
        max-width: 600px; 
        margin-top: 1rem;
    }

    .social-button-card {
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        padding: 0.6rem 1.2rem;
        min-width: 130px;
        font-family: inherit;
        cursor: pointer;
        background-color: var(--main-color, #f4f6f9);
        border: 1px solid var(--shadow-color2, #e5e7eb);
        border-radius: 10px;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow: 0 2px 4px var(--shadow-color2, rgba(0, 0, 0, 0.02));
    }

    .social-button-card:hover {
        background-color: var(--shadow-color2, #e5e7eb);
        border-color: var(--secondary-text-color, #9ca3af);
        transform: translateY(-3px);
        box-shadow: 0 6px 16px var(--shadow-color1, rgba(0, 0, 0, 0.08));
    }

    .social-icon {
        width: 20px;
        height: 20px;
        object-fit: contain;
        transition: transform 0.25s ease;
    }

    .about-languages {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        margin-top: 0.5rem;
    }

    .social-icon1 {
        width: 20px;
        height: 20px;
        object-fit: contain;
        display: inline-block;
        vertical-align: middle;
    }

    .social-text {
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--secondary-text-color, #6f6f6f);
        transition: color 0.25s ease;
    }

    .social-button-card:hover .social-icon {
        transform: scale(1.1);
    }
    .social-button-card:hover .social-text {
        color: var(--text-color, #171717);
    }

    @media (max-width: 768px) {
        header, .navbar {
            position: relative;
            z-index: 1000;
            background-color: #ffffff;
        }

        .dropdown-content.grid-container {
            position: absolute;
            top: 100%;
            right: 5vw;
            left: 5vw;
            width: 90vw !important;
            min-width: 0 !important;
            max-width: none !important;
            grid-template-columns: 1fr !important;
            gap: 8px !important;
            background-color: #ffffff !important;
            z-index: 9999 !important;
            padding: 16px !important;
            border-radius: 12px !important;
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.15) !important;
            border: 1px solid #e5e7eb !important;
            max-height: 70vh;
            overflow-y: auto;
        }

        .dropdown-link {
            display: flex !important;
            align-items: center;
            padding: 12px 16px !important;
            background-color: #f9fafb;
            border-radius: 8px;
            white-space: nowrap;
        }
    }
</style>

<script>
    function setupAvatarFlip() {
        const flipCard = document.getElementById('avatar-flip-card');
        if (flipCard) {
            flipCard.onclick = () => {
                flipCard.classList.toggle('flipped');
            };
        }
    }

    function setupDiscordCopy() {
        const discordBtn = document.querySelector('.discord-copy-btn') as HTMLButtonElement | null;
        const discordText = document.querySelector('.discord-text') as HTMLSpanElement | null;

        if (discordBtn && discordText) {
            discordBtn.addEventListener('click', async () => {
                const discordId = discordBtn.getAttribute('data-discord-id') ?? 'weilinlai719';
                
                try {
                    await navigator.clipboard.writeText(discordId);
                    
                    const originalText = 'Discord';
                    discordText.textContent = 'Copied!';
                    discordText.style.color = '#10b981'; 
                    
                    setTimeout(() => {
                        discordText.textContent = originalText;
                        discordText.style.color = ''; 
                    }, 2000);
                } catch (err) {
                    alert('Copy failed, please copy manually: ' + discordId);
                }
            });
        }
    }

    function initPageScripts() {
        setupAvatarFlip();
        setupDiscordCopy();
    }

    initPageScripts();
    document.addEventListener('DOMContentLoaded', initPageScripts);
    document.addEventListener('astro:page-load', initPageScripts);
</script>
