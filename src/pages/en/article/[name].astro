---
// src/pages/en/article/[name].astro （英文版，網址 /en/article/xxx）
// 讀 article_en（DeepL 自動翻譯出來的），跟中文版邏輯完全一樣，
// 差異只有 collection 名稱、t('en')、語言切換連結指回中文版。
import MainLayout from '../../../layout/mainlayout.astro';
import '../../../styles/style.css';
import '../../../styles/article.css';
import { getEntry, render } from 'astro:content';
import { useTranslations } from '../../../i18n/utils';

export const prerender = false;
const t = useTranslations('en');

const { name } = Astro.params;
if (!name) return Astro.redirect('/404');
const entry = await getEntry('article_en', name);
if (!entry) return Astro.redirect('/404');
const { Content } = await render(entry);
const { title, date, subject } = entry.data;
---

<MainLayout title={`Weilin Lai - ${title}`}>
  <div class="list-page-container">
    <div class="article-detail-topbar">
      <a href="/en/article/" class="article-back-btn">{t('article.backToList')}</a>
    </div>
    <article class="article-post-card">
      <header class="article-detail-header">
        <div class="article-detail-title-wrapper">
          <div class="article-detail-orange-bar"></div>
          <h1 class="article-detail-title">{title}</h1>
        </div>
        <div class="article-detail-meta-wrapper">
          {date && <span class="article-detail-meta-pill">📅 {date}</span>}
          {subject && <span class="article-detail-meta-pill">{subject}</span>}
        </div>
      </header>
      <div class="md-content">
        <Content />
      </div>
    </article>
  </div>
</MainLayout>