---
// src/pages/post/[id].astro
import MainLayout from '../../../layout/mainlayout.astro';
import '../../../styles/style.css';
export const prerender = false;
---

<MainLayout title="Weilin Lai - Post Details">
  <div class="detail-container">
    <a href="/post" class="back-btn">← back to list</a>

    <div id="post-container">
      <div class="loading-text">Loading post content...</div>
    </div>

    <div class="comment-section">
      <h3 class="section-title">💬 Comments</h3>
      
      <div id="comments-container" class="comments-list">
        <div class="loading-text">Loading comments...</div>
      </div>
      
      <div class="comment-form-wrapper panel">
        <h4 class="form-title">Write a Comment</h4>
        <form id="comment-form" class="comment-form">
          <div class="comment-form-group">
            <input type="text" id="comment-name" class="form-input" placeholder="Name" required />
          </div>
          <div class="comment-form-group">
            <textarea id="comment-content" class="form-input" rows="3" placeholder="Comment..." required></textarea>
          </div>
          <button type="submit" class="btn btn-primary">Submit Comment</button>
        </form>
      </div>
    </div>
  </div>
</MainLayout>

<style is:global>


  .post-detail-card {
    background: var(--card-bg);
    border-radius: 20px;
    box-shadow: var(--card-shadow);
    border: 1px solid var(--card-border);
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    position: relative;
  }

  .post-author-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-color);
    margin: 0;
  }

  .post-detail-img {
    max-width: 100%;
    border-radius: 14px;
    margin: 4px 0;
    display: block;
    object-fit: cover;
  }

  .post-content-body {
    font-size: 1.15rem;
    color: #334155;
    line-height: 1.7;
    white-space: pre-wrap;
    word-break: break-all;
    margin: 4px 0 0 0;
  }

  .comment-section {
    margin-top: 16px;
    border-top: 2px solid #eae6e1;
    padding-top: 32px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .section-title {
    font-size: 1.35rem;
    color: var(--text-color);
    margin: 0;
    font-weight: 700;
  }

  .comments-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .comment-item {
    background: var(--card-bg);
    padding: 20px 24px;
    border-radius: 14px;
    border: 1px solid var(--card-border);
    border-left: 4px solid var(--accent-color);
    box-shadow: var(--card-shadow);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .comment-meta-info {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.9rem;
    color: var(--text-color);
    font-weight: bold;
  }

  .comment-time {
    font-weight: normal;
    color: #94a3b8;
    font-size: 0.8rem;
  }

  .comment-text {
    font-size: 1rem;
    color: #475569;
    margin: 0;
    white-space: pre-wrap;
    word-break: break-all;
  }

  .form-title {
    margin: 0;
    color: var(--text-color);
    font-size: 1.1rem;
    font-weight: 700;
  }

  .comment-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }


  .comment-form-group {
    width: 100%;
  }


</style>

<script>
  const API_BASE_URL = 'https://words7000.onrender.com';
  
  const pathParts = window.location.pathname.replace(/\/$/, '').split('/');
  const postId = pathParts[pathParts.length - 1];

  const postContainer = document.getElementById('post-container') as HTMLElement | null;
  const commentsContainer = document.getElementById('comments-container') as HTMLElement | null;
  const commentForm = document.getElementById('comment-form') as HTMLFormElement | null;
  const commentSection = document.querySelector('.comment-section') as HTMLElement | null;

  async function fetchPost() {
    if (!postContainer) return;
    try {
      const res = await fetch(`${API_BASE_URL}/api/post/${postId}`);
      const data = await res.json();
      if (data.success) {
        const dateStr = data.post.time;
        
        const imgHtml = data.post.image 
          ? `<img src="${data.post.image}" class="post-detail-img" alt="貼文圖片" onerror="this.style.display='none'"/>` 
          : '';

        postContainer.innerHTML = `
          <div class="post-detail-card">
            <div class="title-wrapper">
              <div class="orange-bar"></div>
              <h2 class="post-author-title">${data.post.name || 'Anonymous Visitor'}</h2>
            </div>
            
            <div class="meta-wrapper">
              <span class="meta-pill">📅 ${dateStr}</span>
              <span class="meta-pill">${data.post.id}</span>
            </div>
            
            ${imgHtml}
            
            <div class="post-content-body">${data.post.content || ''}</div>
          </div>
        `;
        return true;
      } else {
        postContainer.innerHTML = `
          <div class="post-not-found">
            <div class="not-found-code">404</div>
            <h2 class="not-found-title">Post Not Found</h2>
            <p class="not-found-desc">Post with ID ${postId} does not exist, or it may have been deleted or the URL is incorrect.</p>
            <a href="/post" class="btn btn-primary">← Back to Post List</a>
          </div>
        `;
        window.location.href = "/404/";
        return false;
      }
    } catch (err) {
      postContainer.innerHTML = `<div class="loading-text" style="color:red;">Failed to connect to the server</div>`;
      return false;
    }
  }

  async function fetchComments() {
    if (!commentsContainer) return;
    try {
      const res = await fetch(`${API_BASE_URL}/api/post/${postId}/comments`);
      const data = await res.json();
      if (data.success && data.comments && data.comments.length > 0) {
        commentsContainer.innerHTML = data.comments.map((c: any) => {
          const commentDate = c.time;
          return `
            <div class="comment-item">
              <div class="comment-meta-info">
                <span>👤 ${c.name || 'Anonymous'}</span> 
                <span class="comment-time">${commentDate}</span>
              </div>
              <p class="comment-text">${c.content || ''}</p>
            </div>
          `;
        }).join('');
      } else {
        commentsContainer.innerHTML = `<div class="loading-text" style="color:#888;">Currently no comments</div>`;
      }
    } catch (err) {
      commentsContainer.innerHTML = `<div class="loading-text" style="color:red;">Failed to load comments</div>`;
    }
  }

  if (commentForm) {
    commentForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const nameInput = document.getElementById('comment-name') as HTMLInputElement | null;
      const contentInput = document.getElementById('comment-content') as HTMLTextAreaElement | null;
      if (!nameInput || !contentInput) return;

      const name = nameInput.value.trim();
      const content = contentInput.value.trim();

      if (!name || !content) return;

      try {
        const res = await fetch(`${API_BASE_URL}/api/comment`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ postId, name, content })
        });
        const data = await res.json();
        if (data.success) {
          alert('🎉 Comment submitted successfully!');
          contentInput.value = ''; 
          fetchComments(); 
        } else {
          alert('❌ Failed to submit comment: ' + data.error);
        }
      } catch (err) {
        alert('❌ Failed to connect to the server, please try again later');
      }
    });
  }

  async function init() {
    const found = await fetchPost();
    if (found) {
      fetchComments();
    } else if (commentSection) {
      commentSection.style.display = 'none';
    }
  }

  init();
</script>
