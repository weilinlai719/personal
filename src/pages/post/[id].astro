---
// src/pages/post/[id].astro
// 原路徑誤植於 src/pages/personal/post/[id].astro，且 import 路徑少算一層，
// 已修正為正確的 src/pages/post/[id].astro（與同系列的 post/index.astro、post/edit.astro 對齊）
import MainLayout from '../../layout/mainlayout.astro';
import '../../styles/style.css';
export const prerender = false;
---

<MainLayout title="Weilin Lai - 貼文內容">
  <div class="detail-container">
    <a href="/post" class="back-btn">← 返回列表</a>

    <div id="post-container">
      <div class="loading-text">正在載入貼文內容...</div>
    </div>

    <div class="comment-section">
      <h3 class="section-title">💬 留言回覆</h3>
      
      <div id="comments-container" class="comments-list">
        <div class="loading-text">正在載入留言...</div>
      </div>
      
      <div class="comment-form-wrapper panel">
        <h4 class="form-title">撰寫新留言</h4>
        <form id="comment-form" class="comment-form">
          <div class="comment-form-group">
            <input type="text" id="comment-name" class="form-input" placeholder="署名" required />
          </div>
          <div class="comment-form-group">
            <textarea id="comment-content" class="form-input" rows="3" placeholder="留言內文..." required></textarea>
          </div>
          <button type="submit" class="btn btn-primary">送出留言</button>
        </form>
      </div>
    </div>
  </div>
</MainLayout>

<style is:global>
  /* 貼文內容與留言列表都是用 JS innerHTML 動態產生的，
     Astro 的 scoped <style> 對動態插入的內容不會生效，所以這裡沿用 is:global（與原本一致）。
     .detail-container / .back-btn / .loading-text / .title-wrapper / .orange-bar /
     .meta-wrapper / .meta-pill / .panel / .form-input / .btn 皆已移至 styles/style.css，
     這裡只留下這個頁面獨有、沒有其他地方共用的樣式 */

  .post-detail-card {
    background: var(--card-bg);
    border-radius: 20px;
    box-shadow: var(--card-shadow);
    border: 1px solid var(--card-border);
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    position: relative;
  }

  .post-author-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-color);
    margin: 0;
  }

  .post-detail-img {
    max-width: 100%;
    border-radius: 14px;
    margin: 4px 0;
    display: block;
    object-fit: cover;
  }

  .post-content-body {
    font-size: 1.15rem;
    color: #334155;
    line-height: 1.7;
    white-space: pre-wrap;
    word-break: break-all;
    margin: 4px 0 0 0;
  }

  .comment-section {
    margin-top: 16px;
    border-top: 2px solid #eae6e1;
    padding-top: 32px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .section-title {
    font-size: 1.35rem;
    color: var(--text-color);
    margin: 0;
    font-weight: 700;
  }

  .comments-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .comment-item {
    background: var(--card-bg);
    padding: 20px 24px;
    border-radius: 14px;
    border: 1px solid var(--card-border);
    border-left: 4px solid var(--accent-color);
    box-shadow: var(--card-shadow);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .comment-meta-info {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.9rem;
    color: var(--text-color);
    font-weight: bold;
  }

  .comment-time {
    font-weight: normal;
    color: #94a3b8;
    font-size: 0.8rem;
  }

  .comment-text {
    font-size: 1rem;
    color: #475569;
    margin: 0;
    white-space: pre-wrap;
    word-break: break-all;
  }

  .form-title {
    margin: 0;
    color: var(--text-color);
    font-size: 1.1rem;
    font-weight: 700;
  }

  .comment-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* 這裡的欄位間距已經靠 .comment-form 的 gap 處理，
     所以用專屬的 class，而不是共用的 .form-group（那個是給有各自 margin 的表單用） */
  .comment-form-group {
    width: 100%;
  }
</style>

<script>
  const API_BASE_URL = 'https://words7000.onrender.com';
  
  const pathParts = window.location.pathname.replace(/\/$/, '').split('/');
  const postId = pathParts[pathParts.length - 1];

  const postContainer = document.getElementById('post-container') as HTMLElement | null;
  const commentsContainer = document.getElementById('comments-container') as HTMLElement | null;
  const commentForm = document.getElementById('comment-form') as HTMLFormElement | null;

  async function fetchPost() {
    if (!postContainer) return;
    try {
      const res = await fetch(`${API_BASE_URL}/api/post/${postId}`);
      const data = await res.json();
      if (data.success) {
        const dateStr = data.post.time;
        
        const imgHtml = data.post.image 
          ? `<img src="${data.post.image}" class="post-detail-img" alt="貼文圖片" onerror="this.style.display='none'"/>` 
          : '';

        postContainer.innerHTML = `
          <div class="post-detail-card">
            <div class="title-wrapper">
              <div class="orange-bar"></div>
              <h2 class="post-author-title">${data.post.name || '匿名訪客'}</h2>
            </div>
            
            <div class="meta-wrapper">
              <span class="meta-pill">📅 ${dateStr}</span>
              <span class="meta-pill">${data.post.id}</span>
            </div>
            
            ${imgHtml}
            
            <div class="post-content-body">${data.post.content || ''}</div>
          </div>
        `;
      } else {
        postContainer.innerHTML = `<div class="loading-text" style="color:red;">錯誤: ${data.error}</div>`;
      }
    } catch (err) {
      postContainer.innerHTML = `<div class="loading-text" style="color:red;">無法連線至後端伺服器</div>`;
    }
  }

  async function fetchComments() {
    if (!commentsContainer) return;
    try {
      const res = await fetch(`${API_BASE_URL}/api/post/${postId}/comments`);
      const data = await res.json();
      if (data.success && data.comments && data.comments.length > 0) {
        commentsContainer.innerHTML = data.comments.map((c: any) => {
          const commentDate = c.time;
          return `
            <div class="comment-item">
              <div class="comment-meta-info">
                <span>👤 ${c.name || '匿名'}</span> 
                <span class="comment-time">${commentDate}</span>
              </div>
              <p class="comment-text">${c.content || ''}</p>
            </div>
          `;
        }).join('');
      } else {
        commentsContainer.innerHTML = `<div class="loading-text" style="color:#888;">目前暫無留言</div>`;
      }
    } catch (err) {
      commentsContainer.innerHTML = `<div class="loading-text" style="color:red;">留言載入失敗</div>`;
    }
  }

  if (commentForm) {
    commentForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const nameInput = document.getElementById('comment-name') as HTMLInputElement | null;
      const contentInput = document.getElementById('comment-content') as HTMLTextAreaElement | null;
      if (!nameInput || !contentInput) return;

      const name = nameInput.value.trim();
      const content = contentInput.value.trim();

      if (!name || !content) return;

      try {
        const res = await fetch(`${API_BASE_URL}/api/comment`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ postId, name, content })
        });
        const data = await res.json();
        if (data.success) {
          alert('🎉 留言成功！');
          contentInput.value = ''; 
          fetchComments(); 
        } else {
          alert('❌ 留言失敗: ' + data.error);
        }
      } catch (err) {
        alert('❌ 連線失敗，請稍後再試');
      }
    });
  }

  fetchPost();
  fetchComments();
</script>
