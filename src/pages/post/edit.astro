---
//src/pages/post/edit.astro
import MainLayout from '../../layout/mainlayout.astro';
import '../../styles/style.css';
export const prerender = false;
---

<style is:global>
  /* 這頁的文章管理列表是用 JS innerHTML 動態產生的，
     Astro 的 scoped <style> 對動態插入的內容不會生效，所以這裡沿用 is:global。
     .detail-container / .form-group / .form-input / .btn / .meta-pill / .hash-tag
     皆已移至 styles/style.css，這裡只留下這個頁面獨有的樣式。

     原本這裡有一個裸的 `h2 { ... }` 選擇器，寫在 is:global 裡會影響「全站」所有頁面的
     <h2>（例如 cui.astro、文章內文裡的 h2），已改成只作用在這頁自己的 .post-manage-title。 */

  .panel.form-container h3 {
    margin-top: 0;
    margin-bottom: 24px;
    color: var(--text-color);
    font-size: 1.3rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .file-upload-wrapper {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-top: 8px;
  }

  .upload-status {
    font-size: 0.9rem;
    color: var(--secondary-text-color);
  }

  .preview-container {
    margin-top: 15px;
    display: none;
    position: relative;
    width: fit-content;
  }

  .preview-img {
    max-height: 160px;
    border-radius: 12px;
    border: 1px solid var(--border-color);
    object-fit: cover;
  }

  .btn-remove-preview {
    position: absolute;
    top: -10px;
    right: -10px;
    background: var(--danger-color);
    color: white;
    border: none;
    border-radius: 50%;
    width: 24px;
    height: 24px;
    cursor: pointer;
    font-weight: bold;
    font-size: 0.8rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #posts-management-list {
    display: flex;
    flex-direction: column;
    gap: 25px;
    margin-top: 20px;
  }

  .post-manage-card {
    background: var(--card-bg);
    border-radius: 20px;
    padding: 24px 30px;
    box-shadow: var(--card-shadow);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    border: 1px solid var(--card-border);
  }

  .card-main {
    flex: 1;
    padding-right: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .post-manage-title {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--text-color);
    margin: 0;
  }

  .post-manage-summary {
    font-size: 1.05rem;
    color: var(--secondary-text-color);
    margin: 0;
    line-height: 1.6;
    white-space: pre-wrap;
  }

  .post-manage-img {
    max-width: 100%;
    max-height: 250px;
    border-radius: 12px;
    object-fit: cover;
    display: block;
  }

  .card-action-zone {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex-shrink: 0;
  }

  /* ---- Auth modal（原本整段用 inline style="..." 寫成，改用正式 class 方便維護） ---- */
  .auth-modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    z-index: 9999;
    justify-content: center;
    align-items: center;
  }

  .auth-modal-box {
    background: var(--card-bg);
    padding: 32px;
    border-radius: 20px;
    max-width: 380px;
    width: 90%;
    text-align: center;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
  }

  .auth-modal-icon {
    font-size: 2.5rem;
    margin-bottom: 12px;
  }

  .auth-modal-title {
    margin: 0 0 8px 0;
    color: var(--text-color);
    font-size: 1.3rem;
  }

  .auth-modal-desc {
    color: var(--secondary-text-color);
    font-size: 0.9rem;
    margin: 0 0 20px 0;
  }

  .auth-modal-input {
    margin-bottom: 12px;
    text-align: center;
  }

  .auth-modal-error {
    color: var(--danger-color);
    font-size: 0.85rem;
    display: none;
    margin-bottom: 12px;
  }

  .auth-modal-actions {
    display: flex;
    gap: 10px;
    margin-top: 8px;
  }

  .auth-modal-actions .btn {
    flex: 1;
  }

  .auth-modal-home-link {
    flex: 1;
    background: var(--muted-bg);
    color: #475569;
    text-decoration: none;
    padding: 12px;
    border-radius: 10px;
    font-weight: 600;
    display: inline-block;
  }
</style>

<MainLayout title="文章管理後台">

<div id="auth-modal" class="auth-modal-overlay">
  <div class="auth-modal-box">
    <div class="auth-modal-icon">🔒</div>
    <h3 class="auth-modal-title">管理員解鎖</h3>
    <p class="auth-modal-desc">請輸入管理員密碼以進入後台</p>

    <input type="password" id="admin-pass-input" class="form-input auth-modal-input" placeholder="請輸入密碼..." />
    <div id="auth-error-msg" class="auth-modal-error">❌ 密碼錯誤，請重新輸入</div>

    <div class="auth-modal-actions">
      <button id="btn-auth-submit" class="btn btn-primary">解鎖進入</button>
      <a href="/" class="auth-modal-home-link">返回首頁</a>
    </div>
  </div>
</div>

<div class="detail-container">
  <div class="panel form-container">
    <h3 id="form-title">✨ 發布新動態</h3>
    <form id="post-form">
      <input type="hidden" id="edit-id" />
      <input type="hidden" id="post-image-url" /> 

      <div class="form-group">
        <input 
          type="text" 
          id="post-name" 
          class="form-input"
          value="Weilin" 
          placeholder="署名" 
          required 
        />
      </div>
      
      <div class="form-group">
        <textarea id="post-content" class="form-input" rows="4" placeholder="內文" required></textarea>
      </div>
      <div class="form-group">
         <input 
          type="text" 
          id="post-hashtag" 
          class="form-input"
          value="posts" 
          placeholder="hashtag" 
          required 
        />
      </div>
      <div class="form-group">
        <label class="form-label">分享圖片（選填）</label>
        <div class="file-upload-wrapper">
          <label for="file-input" class="btn btn-outline">選擇電腦中的照片 📷</label>
          <input type="file" id="file-input" accept="image/*" style="display: none;" />
          <span class="upload-status" id="upload-status">尚未選擇檔案</span>
        </div>
        
        <div class="preview-container" id="preview-container">
          <img src="" class="preview-img" id="form-preview-img" alt="預覽圖" />
          <button type="button" class="btn-remove-preview" id="btn-remove-img">✕</button>
        </div>
      </div>

      <button type="submit" id="btn-submit-text" class="btn btn-primary">發布貼文</button>
      <button type="button" id="btn-cancel-edit" class="btn btn-secondary" style="display: none;">取消修改</button>
    </form>
  </div>

  <div id="posts-management-list">
    <p style="color: #a0aec0;">正在載入文章列表...</p>
  </div>
</div>
</MainLayout>

<script>
  const API_BASE_URL = 'https://words7000.onrender.com';

  const authModal = document.getElementById('auth-modal') as HTMLElement | null;
  const adminPassInput = document.getElementById('admin-pass-input') as HTMLInputElement | null;
  const authErrorMsg = document.getElementById('auth-error-msg') as HTMLElement | null;
  const btnAuthSubmit = document.getElementById('btn-auth-submit') as HTMLButtonElement | null;

  const postForm = document.getElementById('post-form') as HTMLFormElement | null;
  const postsListContainer = document.getElementById('posts-management-list') as HTMLElement | null;
  const formTitle = document.getElementById('form-title') as HTMLElement | null;
  const btnSubmitText = document.getElementById('btn-submit-text') as HTMLButtonElement | null;
  const btnCancelEdit = document.getElementById('btn-cancel-edit') as HTMLButtonElement | null;
  const nameInput = document.getElementById('post-name') as HTMLInputElement | null;
  const contentInput = document.getElementById('post-content') as HTMLTextAreaElement | null;
  const imageUrlInput = document.getElementById('post-image-url') as HTMLInputElement | null;
  const editIdInput = document.getElementById('edit-id') as HTMLInputElement | null;
  const hashtagInput = document.getElementById('post-hashtag') as HTMLTextAreaElement | null;
  const fileInput = document.getElementById('file-input') as HTMLInputElement | null;
  const uploadStatus = document.getElementById('upload-status') as HTMLElement | null;
  const previewContainer = document.getElementById('preview-container') as HTMLElement | null;
  const formPreviewImg = document.getElementById('form-preview-img') as HTMLImageElement | null;
  const btnRemoveImg = document.getElementById('btn-remove-img') as HTMLButtonElement | null;

  let isEditing = false;

  function showAuthModal(errorMsg?: string) {
    localStorage.removeItem("admin_key");
    if (authErrorMsg) {
      authErrorMsg.innerText = errorMsg ? `❌ ${errorMsg}` : '❌ 驗證過期或密碼錯誤，請重新輸入';
      authErrorMsg.style.display = 'block';
    }
    if (adminPassInput) {
      adminPassInput.value = '';
      adminPassInput.focus();
    }
    if (authModal) authModal.style.display = 'flex';
  }

  async function checkAuth() {
    const userToken = localStorage.getItem("admin_key");
    
    if (!userToken) {
      if (authErrorMsg) authErrorMsg.style.display = 'none';
      if (authModal) authModal.style.display = 'flex';
      if (adminPassInput) adminPassInput.focus();
      return;
    }

    // 💡 發送請求給後端驗證 token 是否依然有效
    try {
      const res = await fetch(`${API_BASE_URL}/api/verify`, {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${userToken}`
        }
      });
      const data = await res.json();

      if (data.success) {
        if (authModal) authModal.style.display = 'none';
        fetchPosts();
      } else {
        // 💡 Token 在試算表中已被刪除或過期
        showAuthModal('Token 已失效，請重新登入');
      }
    } catch (err) {
      showAuthModal('驗證失敗，請重新登入');
    }
  }
  if (btnAuthSubmit && adminPassInput) {
    btnAuthSubmit.addEventListener('click', async () => {
      const inputVal = adminPassInput.value;

      try {
        const response = await fetch(`${API_BASE_URL}/api/login`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password: inputVal })
        });

        const data = await response.json();

        if (data.success) {
          localStorage.setItem("admin_key", data.token || "authenticated");

          if (authModal) authModal.style.display = 'none';
          if (authErrorMsg) authErrorMsg.style.display = 'none';
          fetchPosts();
        } else {
          if (authErrorMsg) {
            authErrorMsg.innerText = '❌ 密碼錯誤，請重新輸入';
            authErrorMsg.style.display = 'block';
          }
          adminPassInput.value = '';
        }
      } catch (err) {
        alert("無法連線至伺服器驗證密碼");
      }
    });

    adminPassInput.addEventListener('keypress', (e) => {
      if (e.key === 'Enter') {
        btnAuthSubmit.click();
      }
    });
  }

  if (fileInput) {
    fileInput.addEventListener('change', async (e) => {
      const target = e.target as HTMLInputElement;
      if (!target.files || target.files.length === 0) return;

      const file = target.files[0];
      if (uploadStatus) uploadStatus.innerText = '正在上傳圖片... ⏳';

      const formData = new FormData();
      formData.append('image', file);

      const adminKey = localStorage.getItem("admin_key") || "";

      try {
        const response = await fetch(`${API_BASE_URL}/api/upload-image`, {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${adminKey}`
          },
          body: formData
        });

        const result = await response.json();

        if (result.success && result.url) {
          const uploadedUrl = result.url;

          if (imageUrlInput) imageUrlInput.value = uploadedUrl;
          if (uploadStatus) uploadStatus.innerText = '圖片上傳成功！';
          if (formPreviewImg) formPreviewImg.src = uploadedUrl;
          if (previewContainer) previewContainer.style.display = 'block';
        } else {
          alert('圖片上傳失敗');
          if (uploadStatus) uploadStatus.innerText = '上傳失敗';
        }
      } catch (err) {
        alert('上傳時發生連線錯誤');
        if (uploadStatus) uploadStatus.innerText = '連線錯誤';
      }
    });
  }
  if (btnRemoveImg) {
    btnRemoveImg.addEventListener('click', () => {
      if (imageUrlInput) imageUrlInput.value = '';
      if (fileInput) fileInput.value = '';
      if (uploadStatus) uploadStatus.innerText = '尚未選擇檔案';
      if (previewContainer) previewContainer.style.display = 'none';
      if (formPreviewImg) formPreviewImg.src = '';
    });
  }

  async function fetchPosts() {
    if (!postsListContainer) return;
    try {
      const res = await fetch(`${API_BASE_URL}/api/posts`);
      const data = await res.json();
      
      const validPosts = data.success && data.posts 
        ? data.posts.filter((post: any) => post.id) 
        : [];

      if (validPosts.length > 0) {
        const sortedPosts = validPosts.reverse();
        postsListContainer.innerHTML = sortedPosts.map((post: any) => {
          const imgHtml = post.image ? `<img src="${post.image}" class="post-manage-img" alt="貼文圖片" onerror="this.style.display='none'"/>` : '';
          
          return `
            <div class="post-manage-card">
              <div class="card-main">
                <div class="title-wrapper">
                  <div class="orange-bar"></div>
                  <h2 class="post-manage-title">${post.name}</h2>
                </div>
                <div class="meta-wrapper">
                  <span class="meta-pill">📅 ${post.time}</span>
                  <span class="meta-pill">🆔 編號: ${post.id}</span>
                </div>
                ${imgHtml}
                <div class="post-manage-summary">${post.content}</div>
                <span class="hash-tag"># ${post.hashtag || "posts" } </span>
              </div>
              <div class="card-action-zone">
                <button class="btn btn-sm btn-outline" onclick="window.startEdit('${post.id}', '${encodeURIComponent(post.name)}', '${encodeURIComponent(post.content)}', '${post.image || ''}')">修改</button>
                <button class="btn btn-sm btn-danger" onclick="window.deletePost('${post.id}')">刪除</button>
              </div>
            </div>
          `;
        }).join('');
      } else {
        postsListContainer.innerHTML = '<p>目前尚無任何貼文。</p>';
      }
    } catch (err) {
      postsListContainer.innerHTML = '<p style="color:red;">無法連線至後端伺服器</p>';
    }
  }

  if (postForm) {
    postForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!nameInput || !contentInput || !imageUrlInput || !editIdInput || !hashtagInput) return;

      const name = nameInput.value;
      const content = contentInput.value;
      const image = imageUrlInput.value; 
      const id = editIdInput.value;
      const hashtag = hashtagInput.value; 
      const adminKey = localStorage.getItem("admin_key") || "";

      try {
        let res;
        if (isEditing) {
          res = await fetch(`${API_BASE_URL}/api/post/${id}`, {
            method: 'PUT',
            headers: { 
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${adminKey}`
            },
            body: JSON.stringify({ name, content, image, hashtag })
          });
        } else {
          res = await fetch(`${API_BASE_URL}/api/post`, {
            method: 'POST',
            headers: { 
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${adminKey}`
            },
            body: JSON.stringify({ name, content, image, hashtag })
          });
        }

        const data = await res.json();
        if (data.success) {
          alert(isEditing ? '修改成功！' : '發布成功！');
          resetForm();
          fetchPosts();
        } else {
          alert('操作失敗: ' + (data.error || '未授權或驗證已過期'));
          showAuthModal(data.error || '驗證過期，請重新輸入密碼');
        }
      } catch (err) {
        alert('連線失敗，請稍後再試');
      }
    });
  }

  (window as any).startEdit = (id: string, encodedName: string, encodedContent: string, image: string) => {
    if (!nameInput || !contentInput || !imageUrlInput || !editIdInput || !formTitle || !btnSubmitText || !btnCancelEdit) return;
    isEditing = true;
    formTitle.innerText = `✍️ 正在修改編號 #${id} 的貼文`;
    btnSubmitText.innerText = '儲存修改';
    if (btnCancelEdit) btnCancelEdit.style.display = 'inline-block';

    editIdInput.value = id;
    nameInput.value = decodeURIComponent(encodedName);
    contentInput.value = decodeURIComponent(encodedContent);
    imageUrlInput.value = image;

    if (image) {
      if (formPreviewImg) formPreviewImg.src = image;
      if (previewContainer) previewContainer.style.display = 'block';
      if (uploadStatus) uploadStatus.innerText = '已有圖片檔案';
    } else {
      if (previewContainer) previewContainer.style.display = 'none';
      if (uploadStatus) uploadStatus.innerText = '無圖片';
    }

    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  (window as any).deletePost = async (id: string) => {
    if (!confirm(`確定要刪除編號 #${id} 的貼文嗎？`)) return;
    const adminKey = localStorage.getItem("admin_key") || "";

    try {
      const res = await fetch(`${API_BASE_URL}/api/post/${id}`, { 
        method: 'DELETE',
        headers: {
          'Authorization': `Bearer ${adminKey}`
        }
      });
      const data = await res.json();
      if (data.success) {
        alert('文章已成功刪除！');
        if (isEditing && editIdInput?.value === id) resetForm();
        fetchPosts();
      } else {
        alert('刪除失敗: ' + (data.error || '未授權或驗證已過期'));
        showAuthModal(data.error || '驗證過期，請重新輸入密碼');
      }
    } catch (err) {
      alert('連線失敗，無法刪除');
    }
  };

  function resetForm() {
    if (!nameInput || !contentInput || !imageUrlInput || !editIdInput || !formTitle || !btnSubmitText || !btnCancelEdit || !previewContainer) return;
    isEditing = false;
    formTitle.innerText = '✨ 發布新動態';
    btnSubmitText.innerText = '發布貼文';
    btnCancelEdit.style.display = 'none';
    postForm?.reset();
    editIdInput.value = '';
    imageUrlInput.value = '';
    previewContainer.style.display = 'none';
    if (uploadStatus) uploadStatus.innerText = '尚未選擇檔案';
  }

  if (btnCancelEdit) btnCancelEdit.addEventListener('click', resetForm);

  checkAuth();
</script>
